* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve frozen protocols and numerical outputs byte-for-byte so archived
# SHA-256 manifests remain valid after cloning.
*.json -text
*.jsonl -text
*.csv -text

# Binary experiment and manuscript assets.
*.tif binary
*.tiff binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.npz binary
